rules_version = '2';
// CLC SR｜Firestore 規則（權限模型與 YA 一致：Superuser / Admin / Viewer）
// 注意：只提交 GitHub 不會自動變更 Firebase 線上規則，必須到 Firebase Console → Firestore → Rules 發布。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用函式 ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function bootstrapAdmin() {
      return signedIn() && myEmail() in ['darren710404@gmail.com', 'darren.lin@twclc.org'];
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admin_users/$(myEmail())).data;
    }
    function hasAdminDoc() {
      return exists(/databases/$(database)/documents/admin_users/$(myEmail()));
    }
    function isAdmin() {
      return signedIn() && (bootstrapAdmin() ||
        (hasAdminDoc() && adminDoc().role == 'admin' && adminDoc().active == true));
    }
    function isViewer() {
      return signedIn() && !bootstrapAdmin() &&
        hasAdminDoc() && adminDoc().role == 'viewer' && adminDoc().active == true;
    }
    function isBootstrapId(id) {
      return id in ['darren710404@gmail.com', 'darren.lin@twclc.org'];
    }

    // ---------- 管理員名單 ----------
    match /admin_users/{email} {
      // 登入時需要讀「自己的」文件來判斷權限；名單列表只有管理員 / 檢視者可讀。
      allow get: if signedIn() && (myEmail() == email || isAdmin() || isViewer());
      allow list: if isAdmin() || isViewer();

      // 只有管理員可新增 / 修改；欄位與權限值固定；文件 ID 必須是小寫 Email。
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'active', 'notifyReview', 'updatedAt', 'email'])
        && request.resource.data.keys().hasAll(['role', 'active', 'notifyReview'])
        && request.resource.data.role in ['admin', 'viewer']
        && request.resource.data.active is bool
        && request.resource.data.notifyReview is bool
        // 初始管理員永遠是啟用中的 admin，只能調整通知設定。
        && (!isBootstrapId(email) || (request.resource.data.role == 'admin' && request.resource.data.active == true))
        // 檢視者不能接收審核通知。
        && (request.resource.data.role != 'viewer' || request.resource.data.notifyReview == false);

      // 初始管理員不可刪除。
      allow delete: if isAdmin() && !isBootstrapId(email);
    }

    // ---------- 系統設定（首頁背景影片等）：所有人可讀，僅 Admin 可寫 ----------
    match /system_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- SR 業務資料（頁面尚未開放；先以 Admin 可寫、Viewer 唯讀保護）----------
    match /districts/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /groups/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /persons/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /intakes/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /careRecords/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /statusOptions/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
  }
}
