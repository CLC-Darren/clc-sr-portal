rules_version = '2';
// CLC SR｜Firestore 規則（權限模型與 YA 一致：Superuser / Admin / Viewer）
// 注意：只提交 GitHub 不會自動變更 Firebase 線上規則，必須到 Firebase Console → Firestore → Rules 發布。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用函式 ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function bootstrapAdmin() {
      return signedIn() && myEmail() in ['darren710404@gmail.com', 'darren.lin@twclc.org'];
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admin_users/$(myEmail())).data;
    }
    function hasAdminDoc() {
      return exists(/databases/$(database)/documents/admin_users/$(myEmail()));
    }
    function isAdmin() {
      return signedIn() && (bootstrapAdmin() ||
        (hasAdminDoc() && adminDoc().role == 'admin' && adminDoc().active == true));
    }
    function isViewer() {
      return signedIn() && !bootstrapAdmin() &&
        hasAdminDoc() && adminDoc().role == 'viewer' && adminDoc().active == true;
    }
    function isBootstrapId(id) {
      return id in ['darren710404@gmail.com', 'darren.lin@twclc.org'];
    }

    // ---------- 管理員名單 ----------
    match /admin_users/{email} {
      // 登入時需要讀「自己的」文件來判斷權限；名單列表只有管理員 / 檢視者可讀。
      allow get: if signedIn() && (myEmail() == email || isAdmin() || isViewer());
      allow list: if isAdmin() || isViewer();

      // 只有管理員可新增 / 修改；欄位與權限值固定；文件 ID 必須是小寫 Email。
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'active', 'notifyReview', 'updatedAt', 'email'])
        && request.resource.data.keys().hasAll(['role', 'active', 'notifyReview'])
        && request.resource.data.role in ['admin', 'viewer']
        && request.resource.data.active is bool
        && request.resource.data.notifyReview is bool
        // 初始管理員永遠是啟用中的 admin，只能調整通知設定。
        && (!isBootstrapId(email) || (request.resource.data.role == 'admin' && request.resource.data.active == true))
        // 檢視者不能接收審核通知。
        && (request.resource.data.role != 'viewer' || request.resource.data.notifyReview == false);

      // 初始管理員不可刪除。
      allow delete: if isAdmin() && !isBootstrapId(email);
    }

    // ---------- 系統設定（首頁背景影片等）：所有人可讀，僅 Admin 可寫 ----------
    match /system_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- SR 名單資料 ----------
    // 小組名稱與選項不是個資，公開可讀（新朋友登記表單要顯示小組按鈕）；只有 Admin 可修改。
    match /groups/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'order', 'active', 'districtId', 'gender', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }
    match /options/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId == 'lists'
        && request.resource.data.keys().hasOnly(['statuses', 'marital', 'living', 'updatedAt', 'updatedBy']);
    }

    // 組員通訊錄：含地址、生日等個資，只有登入的 Admin / Viewer 可讀，Admin 可寫。
    function validPerson(d) {
      return d.keys().hasOnly(['name', 'gender', 'birthday', 'phone', 'mobile', 'address', 'marital', 'living',
          'groupId', 'status', 'note', 'source', 'memberNo', 'photoThumb', 'category', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('gender' in d) || d.gender in ['女', '男', ''])
        && (!('birthday' in d) || d.birthday == '' || d.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('note' in d) || (d.note is string && d.note.size() <= 2000))
        && (!('address' in d) || (d.address is string && d.address.size() <= 200))
        && (!('category' in d) || d.category in ['', '全職同工', '其他'])
        && (!('memberNo' in d) || (d.memberNo is string && d.memberNo.size() <= 20))
        && (!('photoThumb' in d) || (d.photoThumb is string && d.photoThumb.size() <= 60000));
    }
    match /persons/{docId} {
      allow read: if isAdmin() || isViewer();
      allow create, update: if isAdmin() && validPerson(request.resource.data);
      allow delete: if isAdmin();
    }
    // 組員相片（大圖）：與通訊錄同權限；文件 ID 與組員相同。
    match /personPhotos/{docId} {
      allow read: if isAdmin() || isViewer();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if isAdmin();
    }

    // ---------- 新朋友留名單 ----------
    // 表單不用登入就能送出，但只能「新增」，不能讀、不能改；欄位與長度都有限制。
    function shortStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function validIntake(d) {
      return d.keys().hasOnly(['name', 'gender', 'birthday', 'mobile', 'phone', 'address', 'marital', 'living',
          'groupId', 'groupName', 'refName', 'refRelation', 'refPhone', 'faith', 'intent', 'note', 'photoThumb',
          'status', 'personId', 'joinedAt', 'source', 'notify', 'notifiedAt', 'notifyError', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('gender' in d) || d.gender in ['女', '男', ''])
        && (!('birthday' in d) || d.birthday == '' || d.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && shortStr(d, 'mobile', 30) && shortStr(d, 'phone', 30) && shortStr(d, 'address', 200)
        && shortStr(d, 'marital', 20) && shortStr(d, 'living', 20) && shortStr(d, 'groupId', 40) && shortStr(d, 'groupName', 40)
        && shortStr(d, 'refName', 60) && shortStr(d, 'refRelation', 30) && shortStr(d, 'refPhone', 30)
        && shortStr(d, 'note', 2000) && shortStr(d, 'status', 20) && shortStr(d, 'personId', 40)
        && (!('faith' in d) || (d.faith is list && d.faith.size() <= 10))
        && (!('intent' in d) || (d.intent is list && d.intent.size() <= 10))
        && (!('photoThumb' in d) || (d.photoThumb is string && d.photoThumb.size() <= 60000));
    }
    match /intakes/{docId} {
      allow create: if validIntake(request.resource.data) && (isAdmin() || (
        request.resource.data.source == 'form'
        && request.resource.data.createdAt == request.time
        && !('personId' in request.resource.data) && !('joinedAt' in request.resource.data)
        && (!('status' in request.resource.data) || request.resource.data.status == '')
        && (!('notify' in request.resource.data) || request.resource.data.notify == 'pending')));
      allow read: if isAdmin() || isViewer();
      allow update: if isAdmin() && validIntake(request.resource.data);
      allow delete: if isAdmin();
    }
    // 新朋友的照片（大圖）：只能跟著同一次送出的留名單一起新增
    match /intakePhotos/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && (isAdmin() || (existsAfter(/databases/$(database)/documents/intakes/$(docId))
                          && !exists(/databases/$(database)/documents/intakes/$(docId))));
      allow read: if isAdmin() || isViewer();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 寄給小組長的紀念卡圖片：同樣只能跟著留名單一起新增
    match /intakeCards/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.data.matches('^data:image/jpeg;base64,.*')
        && (isAdmin() || (existsAfter(/databases/$(database)/documents/intakes/$(docId))
                          && !exists(/databases/$(database)/documents/intakes/$(docId))));
      allow read: if isAdmin() || isViewer();
      allow update, delete: if isAdmin();
    }
    // 小組長、區長的通知信箱：不公開，只有同工看得到（寄信程式用專案擁有者身分讀取）
    match /groupContacts/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt', 'updatedBy'])
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 10;
    }

    // ---------- 尚未開放（先以 Admin 可寫、Viewer 唯讀保護）----------
    match /districts/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /careRecords/{docId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
  }
}
