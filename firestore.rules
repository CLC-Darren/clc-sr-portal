rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 輔助函式：判斷是否已登入且通過驗證
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // 初始兩位管理員白名單 (即便尚未在 Firestore 建檔也具備超管權限)
    function isSuperuser() {
      return isSignedIn() &&
        (request.auth.token.email == 'darren710404@gmail.com' ||
         request.auth.token.email == 'darren.lin@twclc.org');
    }

    // 取得當前使用者的 users 資料表文件
    function getUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 檢查是否為生效中的 Admin
    function isAdmin() {
      return isSuperuser() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserRecord().role == 'admin' &&
        getUserRecord().isActive == true
      );
    }

    // 檢查是否為已開通的正式同工 (Admin, 區長, 小組長, 一般同工)
    function isActiveWorker() {
      return isSuperuser() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserRecord().isActive == true
      );
    }

    // ===============================================================
    // 1. 使用者與角色權限表 (users)
    // ===============================================================
    match /users/{userId} {
      // 本人可讀取自己的權限文件；Admin 可讀取全部名冊
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // 新同工首次登入可建立自己的基本草稿 (但預設 isActive: false, 且不可自封 admin)
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == 'viewer' &&
         request.resource.data.isActive == false)
      );

      // 只有 Admin 可以修改角色與開通狀態
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // 2. 牧區 (districts) 與小組 (groups) 組織架構
    // ===============================================================
    match /districts/{districtId} {
      allow read: if isActiveWorker();
      allow write: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isActiveWorker();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 3. 人員主體庫 (persons) 與關懷進度 (intakes)
    // ===============================================================
    match /persons/{personId} {
      // 凡是已開通同工 (包含 viewer) 皆可查閱通訊錄
      allow read: if isActiveWorker();

      // 寫入/更新權限：
      // - Admin 全開
      // - 區長：可寫入轄下牧區
      // - 小組長：可寫入轄下小組
      allow create, update: if isAdmin() || (
        isActiveWorker() && (
          (getUserRecord().role == 'district_leader' && request.resource.data.districtId == getUserRecord().districtId) ||
          (getUserRecord().role == 'group_leader' && request.resource.data.groupId == getUserRecord().groupId)
        )
      );

      allow delete: if isAdmin();
    }

    match /intakes/{intakeId} {
      allow read: if isActiveWorker();

      allow create, update: if isAdmin() || (
        isActiveWorker() && (
          (getUserRecord().role == 'district_leader' && request.resource.data.districtId == getUserRecord().districtId) ||
          (getUserRecord().role == 'group_leader' && request.resource.data.groupId == getUserRecord().groupId)
        )
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. 關懷紀錄 (careRecords)
    // ===============================================================
    match /careRecords/{recordId} {
      allow read: if isActiveWorker();
      allow create: if isActiveWorker();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // 5. 系統狀態字典 (statusOptions)
    // ===============================================================
    match /statusOptions/{docId} {
      allow read: if isActiveWorker();
      allow write: if isAdmin();
    }
  }
}
